diff --git a/Silicon/Apple/AppleSiliconPkg/PrePi/AArch64/ModuleEntryPoint.S b/Silicon/Apple/AppleSiliconPkg/PrePi/AArch64/ModuleEntryPoint.S
index 0811dd7..5b947da 100644
--- a/Silicon/Apple/AppleSiliconPkg/PrePi/AArch64/ModuleEntryPoint.S
+++ b/Silicon/Apple/AppleSiliconPkg/PrePi/AArch64/ModuleEntryPoint.S
@@ -103,10 +103,16 @@ _GetStackBase:
   //TODO - make the PCD value work properly, for now hardcode this value.
   MOV32 (x2, 0x20000)
   sub   x12, x1, x2
+#ifdef J413_BOOT_CONTRACT
+  // Save the base and size across caller-saved cache routines.
+  mov   x23, x12
+  mov   x24, x2
+#else
   //HACK for now - subtract both stack top and base by 0x40 to mitigate an ASSERT
   //TODO - fix the root cause of the stack base being misaligned by 0x40 bytes
   sub   x1, x1, #0x40
   sub   x12, x12, #0x40
+#endif
 
 _StackSetup:
   //x1, top of stack
@@ -121,8 +127,13 @@ _StackSetup:
 _ClearStack: 
   /* Assumes StackBase is 128-bit aligned, StackSize is a multiple of 64B */
   st4     {v4.2d, v5.2d, v6.2d, v7.2d}, [x12], #64  /* Fill every 64 bytes */
+#ifdef J413_BOOT_CONTRACT
+  cmp     x12, x1                                   /* Exclusive stack end */
+  b.lo    _ClearStack
+#else
   cmp     x12, x2                                   /* Compare Size */ 
-  b.lt     _ClearStack 
+  b.lt     _ClearStack
+#endif
 
   //set stack pointer to addr in x1
   add sp, x1, xzr
@@ -132,8 +143,13 @@ _EnableCaches:
   bl ASM_PFX(ArmEnableDataCache)
 
 _PrepareArgumentsAndJump:
+#ifdef J413_BOOT_CONTRACT
+  mov x0, x23 //Unmodified stack base
+  mov x1, x24 //Size preserved across cache routines
+#else
   mov x0, x12 //Stack Base
   mov x1, x2  //Stack Size
+#endif
   mov x2, x26 //DeviceTree pointer
   mov x3, x22 //UEFI memory base
 

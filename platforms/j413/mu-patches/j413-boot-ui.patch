+#ifdef J413_BOOT_CONTRACT
+STATIC BOOLEAN mSetupSelected;
+
+STATIC EFI_STATUS EFIAPI GetJ413SetupOption(OUT EFI_BOOT_MANAGER_LOAD_OPTION *Option)
+{
+  EFI_HANDLE *Handles = NULL;
+  UINTN Count = 0;
+  EFI_STATUS Status;
+  if (Option == NULL) return EFI_INVALID_PARAMETER;
+  if (mSetupSelected) return EFI_NOT_FOUND;
+  // Called by BDS at TPL_APPLICATION, never from a notification callback.
+  J413LogStatus("J413 EFI phase log; not complete UART/kernel log", EFI_SUCCESS);
+  if (gST->ConOut != NULL) Print(L"UEFI TRACE: Setup selector entered; connecting controllers\r\n");
+  Status = J413ConnectBootUsb();
+  if (gST->ConOut != NULL) Print(L"UEFI TRACE: controller connection returned\r\n");
+  {
+    J413_USB_DART_READY *Ready = NULL;
+    EFI_STATUS Probe = gBS->LocateProtocol(&gJ413UsbDartReadyProtocolGuid, NULL, (VOID **)&Ready);
+    J413LogStatus("USB DART readiness protocol", Probe);
+    if (gST->ConOut != NULL) Print(L"UEFI USB: DART readiness protocol: %r\r\n", Probe);
+    if (!EFI_ERROR(Probe) && Ready != NULL) {
+      J413LogCount("DART controller mask", Ready->ControllerMask);
+      if (gST->ConOut != NULL) Print(L"UEFI USB: ready controller mask: 0x%x\r\n", Ready->ControllerMask);
+    }
+  }
+  J413Checkpoint("USB boot connection result", Status);
+  Status = gBS->LocateHandleBuffer(ByProtocol, &gEfiSimpleFileSystemProtocolGuid,
+                                  NULL, &Count, &Handles);
+  if (EFI_ERROR(Status)) {
+    J413Checkpoint("no readable filesystems", Status);
+    if (gST->ConOut != NULL) Print(L"UEFI BOOT: no readable filesystems: %r\r\n", Status);
+    return Status;
+  }
+  J413LogCount("readable filesystem handles", Count);
+  Status = EFI_NOT_FOUND;
+  for (UINTN Index = 0; Index < Count; Index++) {
+    EFI_BLOCK_IO_PROTOCOL *BlockIo = NULL;
+    EFI_SIMPLE_FILE_SYSTEM_PROTOCOL *FileSystem = NULL;
+    EFI_DEVICE_PATH_PROTOCOL *Path;
+    EFI_STATUS Probe = gBS->HandleProtocol(Handles[Index], &gEfiBlockIoProtocolGuid, (VOID **)&BlockIo);
+    if (EFI_ERROR(Probe) || BlockIo == NULL || BlockIo->Media == NULL || !BlockIo->Media->MediaPresent) continue;
+    Probe = gBS->HandleProtocol(Handles[Index], &gEfiSimpleFileSystemProtocolGuid, (VOID **)&FileSystem);
+    if (EFI_ERROR(Probe) || FileSystem == NULL || !HasCompleteSetupMedia(FileSystem)) continue;
+    Path = FileDevicePath(Handles[Index], WINDOWS_FALLBACK_LOADER);
+    if (Path == NULL) { Status = EFI_OUT_OF_RESOURCES; break; }
+    Status = EfiBootManagerInitializeLoadOption(Option, LoadOptionNumberUnassigned,
+                  LoadOptionTypeBoot, LOAD_OPTION_ACTIVE, L"Windows ARM64 Setup", Path, NULL, 0);
+    FreePool(Path);
+    if (!EFI_ERROR(Status)) {
+      mSetupSelected = TRUE;
+      if (gST->ConOut != NULL) Print(L"UEFI BOOT: complete Setup selected; BDS will launch Windows\r\n");
+      break;
+    }
+  }
+  FreePool(Handles);
+  J413Checkpoint("Setup option selection result", Status);
+  if (EFI_ERROR(Status) && gST->ConOut != NULL) {
+    Print(L"UEFI BOOT: Setup selection failed: %r\r\n", Status);
+    Print(L"Check SSD on USB1 and complete readable Setup files.\r\n");
+  }
+  return Status;
+}
+STATIC J413_WINDOWS_SETUP mSetup = { GetJ413SetupOption };
+#endif

+STATIC BOOLEAN HasCompleteSetupMedia(IN EFI_SIMPLE_FILE_SYSTEM_PROTOCOL *FileSystem)
+{
+  CONST CHAR16 *Paths[] = {
+    L"\\EFI\\BOOT\\BOOTAA64.EFI", L"\\EFI\\Microsoft\\Boot\\BCD",
+    L"\\sources\\boot.wim", L"\\boot\\boot.sdi"
+  };
+  EFI_FILE_PROTOCOL *Root = NULL, *File = NULL;
+  EFI_STATUS Status = FileSystem->OpenVolume(FileSystem, &Root);
+  if (EFI_ERROR(Status)) return FALSE;
+  for (UINTN Index = 0; Index < sizeof(Paths)/sizeof(Paths[0]); Index++) {
+    Status = Root->Open(Root, &File, (CHAR16 *)Paths[Index], EFI_FILE_MODE_READ, 0);
+    if (EFI_ERROR(Status)) {
+      CONST CHAR8 *Names[] = { "missing BOOTAA64.EFI", "missing BCD", "missing boot.wim", "missing boot.sdi" };
+      J413LogStatus(Names[Index], Status);
+      if (gST->ConOut != NULL) Print(L"UEFI BOOT: skipping incomplete Setup volume; missing %s\r\n", Paths[Index]);
+      Root->Close(Root);
+      return FALSE;
+    }
+    File->Close(File);
+  }
+  Root->Close(Root);
+  return TRUE;
+}

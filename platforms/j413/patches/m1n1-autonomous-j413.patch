+            base != bases[i] || !irq || length < sizeof(*irq) || irq[0] != irqs[i]) {
+            printf("J413 STOP: live ADT resource mismatch index=%u\n", i);
+            return false;
+        }
+    }
+    int cpus = adt_path_offset(adt, "/cpus");
+    if (cpus < 0)

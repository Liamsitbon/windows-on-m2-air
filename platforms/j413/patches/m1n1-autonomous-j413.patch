+        if (ADT_GETPROP(adt, cpus, "reg", &mpidr) < 0)
+            return false;
+        int index = hv_j413_cpu_index(mpidr);
+        if (index < 0 || (seen & (1U << index)))
+            return false;
+        seen |= 1U << index;
+    }
+    if (seen != 0xff) {
+        printf("J413 STOP: live CPU topology mismatch mask=%#x\n", seen);
+        return false;
+    }

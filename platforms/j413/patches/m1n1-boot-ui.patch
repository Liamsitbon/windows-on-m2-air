+#ifdef M1N1_J413
+static void j413_boot_text(u32 x, u32 y, const char *text, u32 scale)
+{
+    for (; *text; text++, x += console.font.width * scale) {
+        if (*text < 0x20 || *text >= 0x7f)
+            continue;
+        for (u32 row = 0; row < console.font.height; row++)
+            for (u32 col = 0; col < console.font.width; col++) {
+                rgb_t color = font_get_pixel(*text, col, row);
+                for (u32 dy = 0; dy < scale; dy++)
+                    for (u32 dx = 0; dx < scale; dx++)
+                        if (x + col * scale + dx < fb.width && y + row * scale + dy < fb.height)
+                            fb_set_pixel(x + col * scale + dx, y + row * scale + dy, color);
+            }
+    }
+}
+
+void fb_boot_progress(u32 stage, u32 count, const char *name)
+{
+    if (!console.initialized || !count || stage >= count || fb.width < 128 || fb.height < 160)
+        return;
+    u32 x = fb.width / 8, w = fb.width * 3 / 4, y = fb.height - 96;
+    fb_fill(x, y - 40, w, 64, int2rgb(0));
+    j413_boot_text(x, y - 40, name, 1);
+
+    fb_update();
+}
+
+static struct {u32 *pixels; u32 width, height, stride, row; bool active;} fw_console;
+
+void fb_guest_boot_text(u64 base, u32 width, u32 height, u32 stride)
+{
+    /* Validated guest XRGB32 surface, drawn before DCP switches to it. */
+    if (!base || width < 128 || height < 160 || (u64)stride < (u64)width * 4 || stride % 4)
+        return;
+    u32 *pixels = (u32 *)base;
+    fw_console.pixels = pixels;
+    fw_console.width = width;
+    fw_console.height = height;
+    fw_console.stride = stride / 4;
+    fw_console.row = 0;
+    fw_console.active = true;
+    const char *message = "Starting UEFI firmware";
+    u32 text_x = width / 8, text_y = height - 112;
+    if (console.font.width && console.font.height <= 40) {
+        for (; *message && text_x + console.font.width <= width; message++, text_x += console.font.width)
+            for (u32 row = 0; row < console.font.height; row++)
+                for (u32 col = 0; col < console.font.width; col++) {
+                    u32 v = font_get_pixel(*message, col, row).r;
+                    pixels[(text_y + row) * (stride / 4) + text_x + col] = v * 0x010101;
+                }
+    }
+
+}
+void fb_firmware_log_line(const char *line, bool taken)
+{
+    /* GOP is the exclusive display owner after the first explicit takeover marker. */
+    if (taken) {
+        fw_console.active = false;
+        fb_set_active(false);
+        return;
+    }
+    if (!fw_console.active || !console.font.width || !console.font.height || console.font.height > 40)
+        return;
+    u32 rows = (fw_console.height / 2 - 64) / console.font.height;
+    if (!rows) return;
+    u32 y = fw_console.height / 2 + (fw_console.row++ % rows) * console.font.height;
+    u32 *pixels = fw_console.pixels;
+    for (u32 row = 0; row < console.font.height; row++)
+        memset32(pixels + (y + row) * fw_console.stride, 0, fw_console.width * 4);
+    u32 x = 32;
+    for (; *line && x + console.font.width <= fw_console.width; line++, x += console.font.width)
+        for (u32 row = 0; row < console.font.height; row++)
+            for (u32 col = 0; col < console.font.width; col++) {
+                unsigned char c = *line;
+                if (c < 0x20 || c >= 0x7f) c = '?';
+                u32 value = font_get_pixel(c, col, row).r;
+                pixels[(y + row) * fw_console.stride + x + col] = value * 0x010101;
+            }
+    dc_cvac_range(pixels + y * fw_console.stride,
+                  (u64)console.font.height * fw_console.stride * 4);
+}
